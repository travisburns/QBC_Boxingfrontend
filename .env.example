# ---------------------------------------------------------------------------
# Apex Athletic — frontend environment
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values ship to the browser,
# so ONLY publishable identifiers belong here. Never put the Square access
# token or webhook signature key in this file — those live on the backend.
# ---------------------------------------------------------------------------

# Base URL of the .NET backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Square Web Payments SDK (publishable values from the Square Developer Dashboard)
# Use "sandbox" while testing, "production" when you go live.
NEXT_PUBLIC_SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-XXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_SQUARE_LOCATION_ID=LXXXXXXXXXXXXX
